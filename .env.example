# ── PUBLIC configuration only. Anything prefixed VITE_ is shipped to the browser.
# ── NEVER put API keys, secrets, tokens or database credentials here.

VITE_COMPANY_NAME="HostingTech"
VITE_COMPANY_SHORT_NAME="HostingTech"
VITE_SITE_URL="https://www.example.com"

# VITE_CONTACT_EMAIL="[EMAIL]"
VITE_CONTACT_PHONE="+91 76608 89883"
# International format, digits only, e.g. 919876543210
VITE_WHATSAPP_NUMBER="917660889883"
VITE_WHATSAPP_DISPLAY="+91 76608 89883"
VITE_ADDRESS="HSR Layout, 4th Sector, Bengaluru, Karnataka"
VITE_CITY="Bengaluru"

VITE_INSTAGRAM_URL="[INSTAGRAM URL]"
VITE_INSTAGRAM_HANDLE="@yourcompany"
VITE_LINKEDIN_URL="[LINKEDIN URL]"

VITE_PRICE_WEBSITE="₹15,000"
VITE_PRICE_ECOMMERCE="₹25,000"
VITE_PRICE_MARKETING="₹10,000"

# Spring Boot REST API base URL. Leave unset during development to queue leads locally.
# VITE_API_BASE_URL="https://api.yourdomain.com/api/v1"
